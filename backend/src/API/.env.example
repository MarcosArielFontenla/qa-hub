# Entorno
ASPNETCORE_ENVIRONMENT=Development

# Base de datos: formato Railway (postgresql://...) o connection string tradicional.
# Si no se define ninguna, el backend usa una base InMemory para demo.
DATABASE_URL=postgresql://user:password@host:port/database

# Jira (las credenciales viven solo en el backend, nunca llegan al frontend)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=qa@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=QA
JIRA_BUG_ISSUE_TYPE=Bug
JIRA_GHERKIN_FIELD=description

# true fuerza mock mode; si faltan credenciales el backend también cae a mock automáticamente.
JIRA_MOCK_MODE=false

# CORS: único origen permitido para el frontend.
FRONTEND_ORIGIN=http://localhost:5173

# Opcionales: mapeo de campos Jira usados al leer/sincronizar casos.
JIRA_TEST_CASE_ISSUE_TYPE=Sub-task
JIRA_PARENT_FIELD=parent
JIRA_LABELS_FIELD=labels
